# Shared by the Python server and the Mod build script.
# For a public deployment, PUBLIC_HOST should be the IP or DNS name players use.
OVERRANK_SCHEME=http
OVERRANK_PUBLIC_HOST=127.0.0.1
OVERRANK_HOST=127.0.0.1
OVERRANK_PORT=3005
OVERRANK_DATABASE=data/overrank.sqlite3
OVERRANK_API_KEY=

# Optional full public URL override for a reverse proxy, for example:
# OVERRANK_SERVER_URL=https://rank.example.com
